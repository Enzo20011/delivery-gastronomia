# Base de datos (Neon, Railway, o cualquier Postgres)
DATABASE_URL="postgresql://usuario:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generar-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Admin inicial (usado por el seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambiar-esta-clave"

# WhatsApp del negocio (formato internacional, sin +, sin espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"

# Web Push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
